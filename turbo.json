{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "VULCAN_HOME",
    "VULCAN_DESKTOP_WS_URL",
    "VULCAN_BROWSER_HOST_PIPE_PATH",
    "VULCAN_BROWSER_USE_PIPE_PATH",
    "VULCAN_BROWSER_PERF",
    "VULCAN_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "VULCAN_GROK_ACP_DEBUG",
    "VULCAN_WEB_SOURCEMAP",
    "VULCAN_SERVER_SOURCEMAP",
    "VULCAN_DESKTOP_SOURCEMAP",
    "VULCAN_MODE",
    "VULCAN_PORT",
    "VULCAN_NO_BROWSER",
    "VULCAN_AUTH_TOKEN",
    "VULCAN_HERMES_WS_URL",
    "VULCAN_HERMES_TOKEN",
    "VULCAN_PUBLIC_URL",
    "VULCAN_ALLOW_INSECURE_REMOTE",
    "VULCAN_LOG_WS_EVENTS",
    "VULCAN_HOST",
    "VULCAN_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
