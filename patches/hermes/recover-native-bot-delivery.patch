+def test_boot_resume_lock_order_allows_existing_poller_to_enter_mailbox(tmp_path, monkeypatch):
+    import contextlib
+    import threading
+
+    from tui_gateway import bot_live_delivery_startup as startup
+    from tui_gateway import server, session_notifications
+    from tools import bot_live_delivery as mailbox
+
+    db = _bot_chat_db(tmp_path)
