+    import time
+
+    from tui_gateway import server
+
+    admission = threading.Lock()
+    admission.acquire()
+    session = {"_bot_live_delivery_admission_lock": admission}
+    sid = "closing-runtime"
+    original_sessions = server._sessions
+    server._sessions = {sid: session}
+    popped = []
+    monkeypatch.setattr(server, "_teardown_popped_session", lambda value, **_kwargs: popped.append(value) or True)
+    try:
+        thread = threading.Thread(target=server._close_session_by_id, args=(sid,))
+        thread.start()
+        time.sleep(0.05)
+        assert sid in server._sessions
+        admission.release()
+        thread.join(timeout=2)
+        assert not thread.is_alive()
+        assert popped == [session]
+    finally:
+        if admission.locked():
+            admission.release()
+        server._sessions = original_sessions
+
