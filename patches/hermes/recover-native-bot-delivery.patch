+def test_two_process_sender_waits_on_durable_receipt_while_profile_lock_is_held(tmp_path):
+    import os
+    import subprocess
+    import sys
+    import time
+
+    from hermes_cli.active_sessions import try_acquire_active_session
+    from tools import bot_live_delivery as mailbox
+    from tools.bot_relay import acquire_turn_lock
+    from hermes_state import SessionDB
+
+    root = tmp_path
+    profile = root / "profiles" / "research"
+    profile.mkdir(parents=True)
+    db = SessionDB(db_path=profile / "state.db")
+    db.create_session(session_id="chat", source="cli")
+    db.set_session_title("chat", "Bot Chat")
+    lease, refusal = try_acquire_active_session(
+        session_id="chat", surface="cli", config={}, registry_home=profile,
+        metadata={"live_session_id": "chat", "bot_live_delivery_consumer": True},
+    )
+    assert refusal is None
+    dm_file = tmp_path / "dm.txt"
+    dm_file.write_text("child return", encoding="utf-8")
+    worktree = str(Path(__file__).resolve().parents[2])
+    script = (
+        "import sys; from pathlib import Path; "
+        "from tools.bot_mode_dm import _run_delivery; "
+        "raise SystemExit(_run_delivery(['hermes','-p','research','chat'], sys.argv[1], "
+        "stdin_file=False, profile_home=Path(sys.argv[2])))"
+    )
+    env = dict(os.environ, HERMES_HOME=str(root), PYTHONPATH=worktree)
+    try:
+        with acquire_turn_lock(root, "research", timeout_seconds=0):
+            child = subprocess.Popen(
+                [sys.executable, "-c", script, str(dm_file), str(profile)],
+                cwd=worktree, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                text=True,
+            )
+            owner = None
+            deadline = time.monotonic() + 10
+            delivery_id = None
+            while time.monotonic() < deadline:
+                owner = mailbox.find_canonical_live_owner(profile)
+                if owner:
+                    for path in (profile / "runtime" / mailbox.DELIVERY_DIR_NAME).glob("*.json"):
+                        if path.name != ".lock":
+                            delivery_id = path.stem
+                            break
+                if delivery_id:
+                    record = mailbox.read_delivery_result(profile, delivery_id)
+                    if record and record["status"] == "queued":
+                        break
+                time.sleep(0.05)
+            assert owner is not None and delivery_id is not None
+            claimed = mailbox.claim_pending_delivery(profile, owner)
+            assert claimed and claimed["message"] == "child return"
+            mailbox.complete_delivery(profile, delivery_id, status="settled", reply="owner reply")
+            stdout, stderr = child.communicate(timeout=10)
+            assert child.returncode == 0, stderr
+            assert '"status": "settled"' in stdout
+            assert '"delivery_id": "' + delivery_id + '"' in stdout
+            assert mailbox.read_delivery_result(profile, delivery_id)["reply"] == "owner reply"
+    finally:
+        if 'child' in locals() and child.poll() is None:
+            child.kill()
+            child.wait()
+        lease.release()
+        db.close()
+
