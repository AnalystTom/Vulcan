new file mode 100644
index 0000000000..fa5b04ae21
--- /dev/null
+++ b/tests/cli/test_bot_live_delivery.py
@@ -0,0 +1,852 @@
+"""Focused native one-shot Bot Chat mailbox-consumer regressions."""
+from types import SimpleNamespace
+from pathlib import Path
+
+import pytest
+
+
+def _bot_chat_db(tmp_path):
+    from hermes_state import SessionDB
+
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id="chat", source="cli")
+    db.set_session_title("chat", "Bot Chat")
+    return db
+
+
+def _owner(tmp_path, db, *, live="live"):
+    from hermes_cli.active_sessions import try_acquire_active_session
+
+    lease, refusal = try_acquire_active_session(
+        session_id="chat",
+        surface="cli",
+        config={},
+        registry_home=tmp_path,
+        metadata={"live_session_id": live, "bot_live_delivery_consumer": True},
+    )
+    assert refusal is None
+    return lease
+
+
+def test_one_shot_consumer_drains_fifo_mailbox_between_child_completion_polls(tmp_path, monkeypatch):
+    from hermes_cli import cli_bot_live_delivery
+    from tools import bot_live_delivery as mailbox
+
+    db = _bot_chat_db(tmp_path)
+    lease = _owner(tmp_path, db, live="chat")
+    monkeypatch.setattr("hermes_constants.get_hermes_home", lambda: tmp_path)
+    messages = []
+    authors = []
+    cli = SimpleNamespace(
+        _single_query_mode=True,
+        _bot_live_delivery_consumer=True,
+        session_id="chat",
+        _session_db=db,
+        _active_session_lease=lease,
+    )
+    def chat(message):
+        messages.append(message)
+        authors.append(cli._pending_turn_author)
+        cli._last_turn_result = {"completed": True, "final_response": f"reply:{message}"}
+        return f"reply:{message}"
+    cli.chat = chat
+    owner = mailbox.find_canonical_live_owner(tmp_path)
+    first = mailbox.deliver_to_live_owner(
+        tmp_path, owner, "first", author={"id": "bot:one", "name": "One", "is_bot": True})
+    second = mailbox.deliver_to_live_owner(
+        tmp_path, owner, "second", author={"id": "bot:two", "name": "Two", "is_bot": True})
+
+    class Registry:
+        def __init__(self):
+            self.calls = 0
+
+        @staticmethod
+        def _oneshot_completion_wait_seconds():
+            return 1.0
+
+        def wait_for_pending_completions(self, *_args, **_kwargs):
+            self.calls += 1
+            return {"waited": ["child"]} if self.calls == 1 else {"waited": []}
+
+    registry = Registry()
+    monkeypatch.setattr("tools.process_registry.process_registry", registry)
+    try:
+        cli_bot_live_delivery.wait_for_background_completions(cli)
+        assert messages == ["first", "second"]
+        assert authors == [
+            {"id": "bot:one", "name": "One", "is_bot": True},
+            {"id": "bot:two", "name": "Two", "is_bot": True},
+        ]
+        assert mailbox.read_delivery_result(tmp_path, first["delivery_id"])["status"] == "settled"
+        assert mailbox.read_delivery_result(tmp_path, second["delivery_id"])["status"] == "settled"
+        assert registry.calls == 2
+    finally:
+        lease.release()
+        db.close()
+
+
