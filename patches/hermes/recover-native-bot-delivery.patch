diff --git a/hermes_cli/cli_bot_live_delivery.py b/hermes_cli/cli_bot_live_delivery.py
new file mode 100644
index 0000000000..f37ee0b43e
--- /dev/null
+++ b/hermes_cli/cli_bot_live_delivery.py
@@ -0,0 +1,300 @@
+"""Native one-shot Bot Chat mailbox consumption.
+
+A Bot Chat launched as a one-shot CLI is both a durable delivery owner and a
+short-lived process. During its exit linger it can consume replies admitted to
+its existing mailbox, without taking the profile turn lock again.
+"""
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+import time
+from pathlib import Path
+from typing import Any
+
+logger = logging.getLogger(__name__)
+_MISSING = object()
+
+
+def is_bot_live_delivery_consumer(cli: Any) -> bool:
+    """Whether *cli* is the canonical, one-shot Bot Chat mailbox consumer."""
+    if not getattr(cli, "_single_query_mode", False):
+        return False
+    if getattr(cli, "_bot_live_delivery_consumer", False):
+        return True
+    db = getattr(cli, "_session_db", None)
+    session_id = str(getattr(cli, "session_id", "") or "")
+    if db is None or not session_id:
+        return False
+    try:
+        return db.get_session_title(session_id) == "Bot Chat"
+    except Exception:
+        return False
+
+
+def transfer_live_owner_after_compression(cli: Any, new_session_id: str) -> bool:
+    """Move a one-shot Bot Chat's native owner lease to its compression tip."""
+    if not is_bot_live_delivery_consumer(cli):
+        return True
+    lease = getattr(cli, "_active_session_lease", None)
+    if lease is None or getattr(lease, "released", False):
+        return False
+    from hermes_cli.active_sessions import transfer_active_session
+
+    metadata = {
+        # The lease/live identity is stable across compression. Mailbox records
+        # admitted before rotation use this fence while their session id follows
+        # the canonical compression tip.
+        "live_session_id": str(
+            getattr(cli, "_bot_live_delivery_live_session_id", cli.session_id)
+        ),
+        "bot_live_delivery_consumer": True,
+    }
+    transferred = transfer_active_session(lease, session_id=str(new_session_id), metadata=metadata)
+    if not transferred:
+        logger.error(
+            "Could not transfer one-shot Bot Chat mailbox owner lease to compression tip %s",
+            new_session_id,
+        )
+    return transferred
+
+
+def retire_live_owner(profile_home: Path | str, owner: dict[str, Any]) -> dict[str, Any]:
+    """Fence future admissions for an owner before its active lease is released."""
+    from tools.bot_live_delivery import _locked, _owner, _owner_key, _read, _write
+
+    pinned = _owner(profile_home, owner)
+    with _locked(profile_home) as root:
+        path = root / f".retired-{_owner_key(pinned)}.json"
+        existing = _read(path)
+        if existing is not None:
+            if existing.get("owner") != pinned:
+                raise ValueError("retirement marker belongs to a different owner")
+            return existing
+        record = {"owner": pinned, "status": "retired", "retired_at": time.time_ns()}
+        _write(path, record)
+        return record
+
+
+def retire_live_owner_for_session(session: dict[str, Any]) -> bool:
+    """Retire a native Bot Chat owner before its gateway session lease is released."""
+    lease = session.get("active_session_lease")
+    if lease is None or getattr(lease, "released", False):
+        return False
+    from hermes_constants import get_hermes_home
+    from tools.bot_live_delivery import _root, find_canonical_live_owner
+
+    home = Path(session.get("profile_home") or get_hermes_home()).resolve()
+    if not _root(home).is_dir():
+        return False
+    owner = find_canonical_live_owner(home)
+    if owner is None or owner.get("lease_id") != lease.lease_id:
+        return False
+    live_session_id = str(session.get("_sid") or "")
+    if live_session_id and owner.get("live_session_id") != live_session_id:
+        return False
+    retire_live_owner(home, owner)
+    return True
+
+
+def retire_live_owner_for_cli(cli: Any) -> bool:
+    """Retire the current one-shot owner before its active lease is released."""
+    current = _current_owner(cli)
+    if current is None:
+        return False
+    home, owner = current
+    retire_live_owner(home, owner)
+    return True
+
+
+def _same_session_lineage(home: Path, stored: dict[str, Any], current: dict[str, Any]) -> bool:
+    if stored.get("session_id") == current.get("session_id"):
+        return True
+    from hermes_state import SessionDB
+
+    state_db = home / "state.db"
+    if not state_db.is_file():
+        return False
+    db = SessionDB(db_path=state_db, read_only=True)
+    try:
+        return db.get_compression_tip(stored.get("session_id")) == current.get("session_id")
+    finally:
+        db.close()
+
+
+def recover_pending_deliveries(profile_home: Path | str, owner: dict[str, Any]) -> int:
+    """Rebind queued work from a dead owner to the current canonical owner.
+
+    Only queued records are recoverable. A claimed record remains fenced to its
+    original lease and therefore retains its unknown outcome after a crash.
+    """
+    from hermes_cli.active_sessions import active_session_registry_snapshot
+    from tools.bot_live_delivery import _locked, _owner, _read, _write
+
+    home = Path(profile_home).resolve()
+    current = _owner(home, owner)
+    active = active_session_registry_snapshot(registry_home=home)
+    active_leases = {str(entry.get("lease_id") or "") for entry in active}
+    recovered = 0
+    with _locked(home) as root:
+        for path in root.glob("*.json"):
+            record = _read(path)
+            if record is None or record.get("status") != "queued":
+                continue
+            stored = record.get("owner") or {}
+            if stored == current or stored.get("lease_id") in active_leases:
+                continue
+            if not _same_session_lineage(home, stored, current):
+                continue
+            # Keep the first admission owner immutable across repeated restarts.
+            # A present but malformed origin is evidence corruption: leave the
+            # receipt untouched rather than replacing it with an intermediate owner.
+            if "recovered_from" in record:
+                origin = record["recovered_from"]
+                if not isinstance(origin, dict):
+                    continue
+                try:
+                    _owner(home, origin)
+                except (TypeError, ValueError):
+                    continue
+            else:
+                record["recovered_from"] = dict(stored)
+            record["recovered_at"] = time.time_ns()
+            record["owner"] = dict(current)
+            record.update(current)
+            _write(path, record)
+            recovered += 1
+    return recovered
+
+
+def _current_owner(cli: Any) -> tuple[Path, dict[str, Any]] | None:
+    if not is_bot_live_delivery_consumer(cli):
+        return None
+    lease = getattr(cli, "_active_session_lease", None)
+    if lease is None or getattr(lease, "released", False):
+        return None
+    from hermes_constants import get_hermes_home
+    from tools.bot_live_delivery import find_canonical_live_owner
+
+    home = Path(get_hermes_home()).resolve()
+    owner = find_canonical_live_owner(home)
+    if owner is None:
+        return None
+    current_session = str(getattr(cli, "session_id", "") or "")
+    live_session_id = str(
+        getattr(cli, "_bot_live_delivery_live_session_id", current_session) or ""
+    )
+    if (
+        owner.get("profile_home") != str(home)
+        or owner.get("lease_id") != lease.lease_id
+        or owner.get("live_session_id") != live_session_id
+        or owner.get("session_id") != current_session
+    ):
+        return None
+    return home, owner
+
+
+def drain_one(cli: Any) -> bool:
+    """Claim and settle one mailbox envelope for an idle one-shot Bot Chat."""
+    current = _current_owner(cli)
+    if current is None:
+        return False
+    home, owner = current
+    from tools.bot_live_delivery import claim_pending_delivery, complete_delivery
+
+    recover_pending_deliveries(home, owner)
+    claimed = claim_pending_delivery(home, owner)
+    if claimed is None:
+        return False
+    delivery_id = str(claimed["delivery_id"])
+    previous_author = getattr(cli, "_pending_turn_author", _MISSING)
+    cli._pending_turn_author = claimed.get("author") or None
+    # Clear prior-turn state before an early return can be mistaken for this delivery.
+    cli._last_turn_result = None
+    cli._last_turn_interrupted = False
+    try:
+        # The normal CLI turn path owns persistence, model setup and compression.
+        # Silence its terminal rendering: the delivery receipt is the authoritative output.
+        with open(os.devnull, "w", encoding="utf-8") as sink:
+            with contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
+                response = cli.chat(claimed["message"])
+        outcome = getattr(cli, "_last_turn_result", None)
+        interrupted = bool(getattr(cli, "_last_turn_interrupted", False)) or (
+            isinstance(outcome, dict) and bool(outcome.get("interrupted"))
+        )
+        if interrupted:
+            error = (
+                str(outcome.get("error") or "mailbox turn interrupted")
+                if isinstance(outcome, dict) else "mailbox turn interrupted"
+            )
+            complete_delivery(home, delivery_id, status="cancelled", error=error, reason="cancelled")
+        elif (
+            response is None
+            or not isinstance(outcome, dict)
+            or outcome.get("completed") is not True
+            or outcome.get("failed")
+            or outcome.get("partial")
+        ):
+            error = (
+                str(outcome.get("error") or "mailbox turn did not complete")
+                if isinstance(outcome, dict) else "mailbox turn did not return a terminal result"
+            )
+            from tools.bot_failure_reasons import classify_agent_error
+            complete_delivery(
+                home, delivery_id, status="failed", error=error,
+                reason=classify_agent_error(error),
+            )
+        else:
+            complete_delivery(home, delivery_id, status="settled", reply=str(response))
+    except Exception as exc:
+        error = str(exc) or type(exc).__name__
+        from tools.bot_failure_reasons import classify_agent_error
+        complete_delivery(
+            home, delivery_id, status="failed", error=error,
+            reason=classify_agent_error(error),
+        )
+    finally:
+        if previous_author is _MISSING:
+            delattr(cli, "_pending_turn_author")
+        else:
+            cli._pending_turn_author = previous_author
+    return True
+
+
+def wait_for_background_completions(cli: Any) -> None:
+    """Linger while tracked children finish, draining native replies between polls."""
+    from tools.process_registry import process_registry
+
+    wait_seconds = max(float(process_registry._oneshot_completion_wait_seconds()), 0.0)
+    if wait_seconds <= 0:
+        return
+    deadline = time.monotonic() + wait_seconds
+    waited: set[str] = set()
+    completed: set[str] = set()
+    timed_out: set[str] = set()
+    drained = 0
+    while time.monotonic() < deadline:
+        progress = drain_one(cli)
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            break
+        result = process_registry.wait_for_pending_completions(
+            None, timeout=min(0.25, remaining), poll_interval=0.05,
+        )
+        waited.update(result.get("waited", ()))
+        completed.update(result.get("completed", ()))
+        timed_out.update(result.get("timed_out", ()))
+        drained += int(progress)
+        progress = drain_one(cli)
+        drained += int(progress)
+        if not result.get("waited") and not progress:
+            break
+    # A final claim closes the small race between a child receipt settlement and its
+    # completion notification. Claimed work is never retried if this process exits.
+    drained += int(drain_one(cli))
+    if waited:
+        logger.info(
+            "One-shot Bot Chat mailbox linger: waited=%s completed=%s timed_out=%s drained=%d",
+            sorted(waited), sorted(completed), sorted(timed_out), drained,
+        )
