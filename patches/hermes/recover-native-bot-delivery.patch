+"""Boot reconciliation for queued Bot Chat mailbox work.
+
+This path only revives an existing canonical Bot Chat when its mailbox contains
+never-claimed work whose previous owner is dead. It uses session.resume and
+the normal TUI session poller; it never submits a prompt or creates a session.
+"""
+from __future__ import annotations
+
+import contextlib
+import logging
+import threading
+from pathlib import Path
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+def _canonical_session_id(home: Path) -> str | None:
+    from hermes_state import SessionDB
+
+    state_db = home / "state.db"
+    if not state_db.is_file():
+        return None
+    db = SessionDB(db_path=state_db, read_only=True)
+    try:
+        row = db.get_session_by_title("Bot Chat")
+        if not row:
+            return None
+        return str(db.get_compression_tip(row["id"]) or row["id"])
+    finally:
+        db.close()
+
+
+def _lineage_is_canonical(home: Path, owner: dict[str, Any], canonical: str) -> bool:
+    stored_id = str(owner.get("session_id") or "")
+    if not stored_id:
+        return False
+    if stored_id == canonical:
+        return True
+    from hermes_state import SessionDB
+
+    db = SessionDB(db_path=home / "state.db", read_only=True)
+    try:
+        return db.get_compression_tip(stored_id) == canonical
+    finally:
+        db.close()
+
+
+def _has_dead_queued_work_locked(home: Path, canonical: str) -> bool:
+    """Check the mailbox while its lock is held; no receipt is changed."""
+    from hermes_cli.active_sessions import active_session_registry_snapshot
+    from tools.bot_live_delivery import _read, _root
+
+    root = _root(home)
+    if not root.is_dir():
+        return False
+    try:
+        active = active_session_registry_snapshot(registry_home=home)
+    except Exception:
+        logger.warning("Bot Chat boot reconciliation skipped: active-session registry unreadable", exc_info=True)
+        return False
+    active_leases = {str(entry.get("lease_id") or "") for entry in active}
+    active_sessions = {str(entry.get("session_id") or "") for entry in active}
+    if canonical in active_sessions:
+        return False
+    for path in root.glob("*.json"):
+        record = _read(path)
+        if record is None or record.get("status") != "queued":
+            continue
+        owner = record.get("owner")
+        if not isinstance(owner, dict) or not owner.get("lease_id"):
+            continue
+        if str(owner.get("lease_id")) in active_leases:
+            continue
+        if _lineage_is_canonical(home, owner, canonical):
+            return True
+    return False
+
+
+def _profile_targets(initial_profile: str = "") -> list[tuple[str, Path]]:
+    """Return only profiles this serve process owns, using the native chokepoint."""
+    from hermes_cli.profiles import profiles_to_serve
+    from hermes_constants import get_default_hermes_root, get_hermes_home, profile_name_for_home
+
+    # The machine-root dashboard/serve is app-global and exposes every live
+    # profile even when gateway multiplexing is not configured. A profile-home
+    # isolated backend owns only its active profile.
+    try:
+        root = Path(get_default_hermes_root()).resolve()
+        current = Path(get_hermes_home()).resolve()
+    except Exception:
+        root = current = None
+    if root is not None and current == root:
+        return list(profiles_to_serve(multiplex=True))
+    # Explicit --profile launches set HERMES_HOME to that named home even when
+    # the root sticky active_profile names another profile. Keep boot and
+    # heartbeat reconciliation scoped to this process-owned home.
+    if current is not None:
+        name = profile_name_for_home(current) or initial_profile or "default"
+        return [(name, current)]
+    return list(profiles_to_serve(multiplex=False))
+
+
+def _resume_existing_bot_chat(profile: str, home: Path) -> bool:
+    from tools.bot_live_delivery import _locked
+
+    # Avoid creating mailbox state for profiles with no native delivery work.
+    # The startup scan is read-only until a real queued receipt is found.
+    if not (home / "runtime" / "bot_live_delivery").is_dir():
+        return False
+
+    from tui_gateway import server
+
+    # Candidate discovery must not hold the mailbox lock while native resume
+    # starts a poller. The poller takes the per-session admission lock before
+    # entering the mailbox, so holding mailbox -> admission here would invert
+    # its lock order and deadlock an already-running session.
+    with _locked(home):
+        canonical = _canonical_session_id(home)
+        if not canonical or not _has_dead_queued_work_locked(home, canonical):
+            return False
+
+    params: dict[str, Any] = {
+        "session_id": canonical,
+        "eager_build": True,
+        "skip_auto_continue": True,
+        "internal_boot": True,
+    }
+    if profile != "default":
+        params["profile"] = profile
+    transport_token = server.bind_transport(server._detached_ws_transport)
+    try:
+        response = server.handle_request({
+            "jsonrpc": "2.0", "id": f"__bot_live_boot__{canonical}",
+            "method": "session.resume", "params": params,
+        })
+    finally:
+        server.reset_transport(transport_token)
+
+    result = response.get("result") if isinstance(response, dict) else None
+    runtime_sid = str((result or {}).get("session_id") or "")
+    if not runtime_sid:
+        logger.warning("Bot Chat boot resume failed for profile %s: %s", profile, response)
+        return False
+
+    # The native resume response identifies whether this request minted the
+    # runtime; do not infer ownership from a concurrent _sessions snapshot.
+    newly_created = bool((result or {}).get("internal_boot_created"))
+    session = server._sessions.get(runtime_sid)
+    cleanup_sid: str | None = None
+    resumed = False
+    if not isinstance(session, dict) or session.get("agent") is None:
+        logger.warning("Bot Chat boot resume returned no ready session for profile %s", profile)
+        if newly_created:
+            cleanup_sid = runtime_sid
+    else:
+        # Admission is the first lock in the native poller's order. Recheck
+        # the durable candidate only after taking it: an existing poller may
+        # have consumed or recovered the envelope while resume was in flight.
+        delivery_lock = session.setdefault("_bot_live_delivery_admission_lock", threading.Lock())
+        refusal: str | None = None
+        with delivery_lock:
+            with server._sessions_lock:
+                still_owned = server._sessions.get(runtime_sid) is session
+                stopped = bool(session.get("_finalized") or session.get("_closing"))
+            if not still_owned or stopped:
+                refusal = "session stopped during boot resume"
+            else:
+                with _locked(home):
+                    current_canonical = _canonical_session_id(home)
+                    if (current_canonical != canonical
+                            or not current_canonical
+                            or not _has_dead_queued_work_locked(home, current_canonical)):
+                        refusal = "queued work was adopted during boot resume"
+                    else:
+                        try:
+                            with server._session_profile_runtime_scope(session):
+                                refusal = server._ensure_active_session_slot(runtime_sid, session)
+                        except Exception:
+                            logger.warning("Bot Chat boot owner claim failed for profile %s", profile, exc_info=True)
+                            refusal = "owner claim failed"
+            session.pop("_bot_live_delivery_boot_pending", None)
+        if refusal is not None:
+            logger.warning("Bot Chat boot owner claim refused for profile %s: %s", profile, refusal)
+            if newly_created:
+                cleanup_sid = runtime_sid
