+            if receipt and receipt.get("status") == "settled":
+                break
+            time.sleep(0.05)
+        assert receipt["status"] == "settled"
+        assert receipt["reply"] == "native poller reply"
+        assert any(session.get("active_session_lease") for session in server._sessions.values())
+        assert any(session.get("transport") is server._detached_ws_transport for session in server._sessions.values())
+    finally:
+        for session in list(server._sessions.values()):
+            stop = session.get("_notif_stop")
+            if stop is not None:
+                stop.set()
+            lease = session.get("active_session_lease")
+            if lease is not None:
+                lease.release()
+        server._sessions = original_sessions
+        db.close()
+
