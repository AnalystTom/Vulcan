+    old_owner = mailbox.find_canonical_live_owner(tmp_path)
+    mailbox.deliver_to_live_owner(tmp_path, old_owner, "lock-order work")
+    old_lease.release()
+
+    admission = threading.Lock()
+    poller_entered = threading.Event()
+    poller_finished = threading.Event()
+    lock_errors = []
+    mailbox_lock = threading.Lock()
+
+    @contextlib.contextmanager
+    def instrumented_locked(home):
+        if not mailbox_lock.acquire(timeout=0.2):
+            raise AssertionError("mailbox lock inversion")
+        try:
+            yield mailbox._root(home)
+        finally:
+            mailbox_lock.release()
+
+    runtime = "existing-runtime"
+    session = {
+        "agent": object(),
+        "_bot_live_delivery_admission_lock": admission,
+        "profile_home": str(tmp_path),
+    }
+    original_sessions = server._sessions
+    server._sessions = {runtime: session}
+    poller_threads = []
+
+    def fake_poll(_sid, _session):
+        poller_entered.set()
+        try:
+            with mailbox._locked(tmp_path):
+                pass
+        except Exception as exc:
+            lock_errors.append(exc)
+        finally:
+            poller_finished.set()
+        return True
+
+    monkeypatch.setattr(session_notifications, "_poll_bot_live_delivery_once_impl", fake_poll)
+
+    def fake_resume(_request):
+        def existing_poller():
+            session_notifications._poll_bot_live_delivery_once(runtime, session)
+
+        poller = threading.Thread(target=existing_poller, daemon=True)
+        poller_threads.append(poller)
+        poller.start()
+        assert poller_entered.wait(timeout=1)
+        return {"result": {"session_id": runtime, "internal_boot_created": False}}
+
+    monkeypatch.setattr(startup, "_profile_targets", lambda _initial="": [("default", tmp_path)])
+    monkeypatch.setattr(mailbox, "_locked", instrumented_locked)
+    monkeypatch.setattr(server, "handle_request", fake_resume)
+    monkeypatch.setattr(server, "bind_transport", lambda transport: transport)
+    monkeypatch.setattr(server, "reset_transport", lambda _token: None)
+    monkeypatch.setattr(server, "_session_profile_runtime_scope", lambda _session: contextlib.nullcontext())
+
+    def ensure(_sid, value):
+        value["active_session_lease"] = SimpleNamespace(released=False, release=lambda: None)
+        return None
+
+    monkeypatch.setattr(server, "_ensure_active_session_slot", ensure)
+    try:
+        assert startup.reconcile_queued_bot_chats() == 1
+        assert poller_finished.wait(timeout=1)
+        assert not lock_errors
+        for poller in poller_threads:
+            poller.join(timeout=1)
+            assert not poller.is_alive()
+    finally:
+        server._sessions = original_sessions
+        db.close()
+
