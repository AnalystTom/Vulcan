+def _has_fresh_interrupted_turn(home: Path, canonical: str) -> bool:
+    """Return whether the canonical Bot Chat has an explicit opt-in crash marker.
+
+    The auto-continue helper remains the policy owner; this preflight only
+    decides whether startup should call session.resume without suppressing
+    that helper. Disabled, stale, exhausted, or non-ordinary markers remain
+    durable evidence for an explicit client resume. Startup requires a raw
+    desktop.auto_continue.enabled: true because the ordinary helper's
+    upstream default is enabled when the field is absent.
+    """
+    from tui_gateway import server
+    from tui_gateway.turn_marker import read_turn_marker
+
+    marker = read_turn_marker(home, canonical)
+    if marker is None or not marker.get("auto_continue", True) or not _explicit_auto_continue_enabled(home):
+        return False
+    try:
+        with server._session_profile_runtime_scope({"profile_home": str(home)}):
+            enabled, freshness_secs, max_attempts = server._auto_continue_config()
+        age = time.time() - float(marker.get("started_at") or 0)
+        return bool(enabled) and age <= freshness_secs and int(marker.get("attempts") or 0) < max_attempts
+    except Exception:
+        return False
