+def test_session_resume_runs_native_auto_continue_once_through_fast_completion(monkeypatch, tmp_path):
+    """The joined native resume path owns the final kickoff and tolerates a fast marker clear."""
+    from hermes_state import SessionDB
+    from tui_gateway import bot_live_delivery_startup as startup
+    from tui_gateway.turn_marker import clear_turn_marker
+
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id="chat", source="cli")
+    db.set_session_title("chat", "Bot Chat")
+    (tmp_path / "config.yaml").write_text(
+        chr(10).join(["desktop:", "  auto_continue:", "    enabled: true", ""]),
+        encoding="utf-8",
+    )
+    record_turn_start(tmp_path, "chat", "finish the interrupted goal", attempts=1)
+    calls = []
+    finished = threading.Event()
+    agent = types.SimpleNamespace(model="test", provider="test", close=lambda: None)
+    previous_sessions = server._sessions
+
+    def fake_run(_rid, _sid, session, text, **kwargs):
+        calls.append((session["session_key"], text, kwargs["display_kind"]))
+        # A successful model turn clears the marker before the resume caller
+        # receives control, reproducing the real fast-completion race.
+        clear_turn_marker(tmp_path, session["session_key"])
+        with session["history_lock"]:
+            session["running"] = False
+        finished.set()
+
+    monkeypatch.setattr(server, "_hermes_home", tmp_path)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(server, "_schedule_session_cap_enforcement", lambda: None)
+    monkeypatch.setattr(server, "_completion_cwd", lambda: str(tmp_path))
+    monkeypatch.setattr(server, "_make_agent_in_context", lambda *a, **k: agent)
+    monkeypatch.setattr(server, "_hydrate_session_cwd", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_register_session_cwd", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_wire_session_agent", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_start_session_services", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_schedule_mcp_late_refresh", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_session_todo_state", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_session_info", lambda *a, **k: {"model": "test"})
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_auto_continue_config", lambda: (True, 900.0, 2))
+    monkeypatch.setattr(server, "_start_agent_build", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_run_prompt_submit", fake_run)
+    monkeypatch.setattr(server, "_sessions", {})
+    try:
+        monkeypatch.setattr(startup, "_profile_targets", lambda _initial="": [("default", tmp_path)])
+        assert startup.reconcile_queued_bot_chats(recover_interrupted=True) == 1
+        assert finished.wait(timeout=2.0)
+        assert calls and calls[0][0] == "chat"
+        assert len(calls) == 1
+        assert read_turn_marker(tmp_path, "chat") is None
+
+        # A second startup pass sees the completed marker and cannot schedule
+        # the same ordinary turn again.
+        assert startup.reconcile_queued_bot_chats(recover_interrupted=True) == 0
+        assert len(calls) == 1
+    finally:
+        for session in list(server._sessions.values()):
+            lease = session.get("active_session_lease")
+            if lease is not None:
+                lease.release()
+        server._sessions = previous_sessions
+        db.close()
+
