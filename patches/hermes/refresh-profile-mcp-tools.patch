+def _claim_profile_mcp_refresh_generation(profile_home) -> int:
+    profile_home = str(Path(profile_home).resolve())
+    with _mcp_grant_refresh_lock:
+        generation = int(_mcp_grant_refresh_generations.get(profile_home, 0)) + 1
+        _mcp_grant_refresh_generations[profile_home] = generation
+        return generation
+
+
+def _profile_mcp_refresh_is_current(profile_home, generation: int) -> bool:
+    return _mcp_grant_refresh_generations.get(str(Path(profile_home).resolve())) == generation
+
