+def _refresh_profile_mcp_grant(profile_dir, generation: int | None = None) -> None:
+    """Discover one profile's newly granted MCP servers and refresh its idle sessions.
+
+    A live turn owns its tool snapshot until the next turn boundary. Marking that agent
+    pending lets the boundary hook retry discovery without changing tools mid-request.
+    """
+    profile_home = str(Path(profile_dir).resolve())
+    if generation is None:
+        generation = _claim_profile_mcp_refresh_generation(profile_home)
+    scopes = _bind_build_profile_scopes(profile_home)
+    try:
+        from hermes_cli.config import load_config
+        from hermes_cli.tools_config import enabled_mcp_server_names
+        from tools.mcp_tool_agent import reprobe_tool_availability, refresh_agent_mcp_tools
+        from tools.mcp_tool_discovery import discover_mcp_tools, get_mcp_status
+
+        with _mcp_grant_refresh_lock:
+            if not _profile_mcp_refresh_is_current(profile_home, generation):
+                return
+            enabled_toolsets = _load_enabled_toolsets()
+            config = load_config() or {}
+            configured_mcp = enabled_mcp_server_names(config)
+            required_mcp = (configured_mcp if enabled_toolsets is None
+                            else configured_mcp.intersection(enabled_toolsets))
+            mcp_servers = config.get("mcp_servers") if isinstance(config.get("mcp_servers"), dict) else {}
+            required_configs = {name: mcp_servers[name] for name in required_mcp
+                                if isinstance(mcp_servers.get(name), dict)}
+            with _sessions_lock:
+                sessions = list(_sessions.items())
+            matching = []
+            for sid, session in sessions:
+                session_home = str(Path(session.get("profile_home") or _hermes_home).resolve())
+                if session_home != profile_home:
+                    continue
+                agent = session.get("agent")
+                if agent is None:
+                    continue
+                matching.append((sid, session, agent))
+                with session["history_lock"]:
+                    if _sessions.get(sid) is session:
+                        agent._mcp_refresh_pending = True
+                        agent._mcp_refresh_generation = generation
+                        agent._mcp_refresh_enabled_toolsets = enabled_toolsets
+                        agent._mcp_refresh_required_servers = set(required_mcp)
+
+        reprobe_tool_availability()
+        discover_mcp_tools()
+        statuses = get_mcp_status(required_configs, include_runtime=True) if required_mcp else []
+        ready_servers = {entry.get("name") for entry in statuses if entry.get("connected")}
+        refresh_ready = not required_mcp or required_mcp <= ready_servers
+
+        updates = []
+        for sid, session, agent in matching:
+            with _mcp_grant_refresh_lock:
+                if not _profile_mcp_refresh_is_current(profile_home, generation):
+                    return
+                with session["history_lock"]:
+                    if _sessions.get(sid) is not session:
+                        continue
+                    if session.get("running"):
+                        continue
+                    before = json.dumps(getattr(agent, "tools", []) or [], sort_keys=True, default=str)
+                    if enabled_toolsets is None:
+                        agent.enabled_toolsets = None
+                        refresh_agent_mcp_tools(agent, quiet_mode=True, content_aware=True, preserve_prefix=False)
+                    else:
+                        refresh_agent_mcp_tools(
+                            agent, enabled_override=enabled_toolsets,
+                            quiet_mode=True, content_aware=True, preserve_prefix=False)
+                    after = json.dumps(getattr(agent, "tools", []) or [], sort_keys=True, default=str)
+                    if before != after:
+                        updates.append((sid, _session_info(agent, session)))
+                    if refresh_ready:
+                        agent._mcp_refresh_pending = False
+                        agent._mcp_refresh_generation = None
+                        agent._mcp_refresh_enabled_toolsets = None
+                        agent._mcp_refresh_required_servers = None
+        for sid, info in updates:
+            with _mcp_grant_refresh_lock:
+                if not _profile_mcp_refresh_is_current(profile_home, generation):
+                    return
+                _emit("session.info", sid, info)
+    except Exception as exc:
+        logger.warning("Profile MCP grant refresh failed for %s: %s", profile_home, exc)
+    finally:
+        _release_build_profile_scopes(scopes)
+
