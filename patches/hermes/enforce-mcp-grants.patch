+def test_profile_mcp_grant_uses_enabled_and_matches_runtime_resolver():
+    from hermes_cli.tools_config import _get_platform_tools, enabled_mcp_server_names
+    from tui_gateway.methods_profiles import _save_mcp_toggles
+    from tui_gateway.mcp_rpc_helpers import summarize_server
+
+    cfg = {
+        "mcp_servers": {
+            "safe": {"command": "python", "args": ["-c", "pass"], "disabled": False},
+            "old": {"command": "python", "args": ["-c", "pass"], "disabled": False},
+        }
+    }
+    saved = []
+    _save_mcp_toggles(cfg, ["safe"], {}, lambda value: saved.append(copy.deepcopy(value)))
+
+    persisted = saved[0]
+    assert persisted["mcp_servers"]["safe"]["enabled"] is True
+    assert persisted["mcp_servers"]["old"]["enabled"] is False
+    assert all("disabled" not in entry for entry in persisted["mcp_servers"].values())
+    assert enabled_mcp_server_names(persisted) == {"safe"}
+    assert summarize_server("safe", persisted["mcp_servers"]["safe"])["enabled"] is True
+    assert summarize_server("old", persisted["mcp_servers"]["old"])["enabled"] is False
+    assert summarize_server("legacy-string-off", {"enabled": "false"})["enabled"] is False
+    resolved = _get_platform_tools(
+        {"tools": {"enabled_toolsets": ["safe"]}, "mcp_servers": persisted["mcp_servers"]},
+        "cli",
+        include_default_mcp_servers=False,
+    )
+    assert "safe" in resolved
+    assert "old" not in resolved
