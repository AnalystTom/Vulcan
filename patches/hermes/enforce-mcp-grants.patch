+def _server_granted_in_current_profile(server_name: str) -> bool:
+    """Re-read the current profile's MCP grant before every registered-tool call.
+
+    The connection registry may be shared across profile scopes, so a live connection
+    is not itself authorization for the caller's current profile. Use the same resolver
+    as agent construction so ``enabled`` flags, profile pins, and ``no_mcp`` keep one
