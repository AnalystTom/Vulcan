+def test_revoke_while_waiting_for_rpc_lock_blocks_backend_call(monkeypatch):
+    """The post-lock check prevents a revoke racing with an in-flight handler wait."""
+    from tools import mcp_tool_discovery as discovery
+    import tools.mcp_tool_handlers as handlers
+
+    allowed = True
+    backend = AsyncMock()
+    backend.call_tool = AsyncMock(return_value=SimpleNamespace(content=[], isError=False))
+    connected = SimpleNamespace(session=backend, _config={})
+    monkeypatch.setattr(discovery, "_server_granted_in_current_profile", lambda _name: allowed)
+    monkeypatch.setattr(discovery, "_server_matches_current_profile", lambda _name, _server: True)
+    monkeypatch.setattr(discovery, "_get_connected_server_for_call", lambda _name: connected)
+
+    def dispatch_with_revoke(_server_name, server, _op, call, _timeout, _recoverers, _failure, **_kwargs):
+        async def scenario():
+            nonlocal allowed
+            server._rpc_lock = asyncio.Lock()
+            await server._rpc_lock.acquire()
+            pending = asyncio.create_task(call())
+            await asyncio.sleep(0)
+            allowed = False
+            server._rpc_lock.release()
+            return await pending
+        return asyncio.run(scenario())
+
+    monkeypatch.setattr(handlers, "_dispatch", dispatch_with_revoke)
+    result = handlers._make_tool_handler("grant-canary", "diagnostic_identity", 5.0)({})
+
+    assert json.loads(result)["error"]
+    backend.call_tool.assert_not_awaited()
+
