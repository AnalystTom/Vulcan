new file mode 100644
index 0000000000..a6d7e1af64
--- /dev/null
+++ b/tests/agent/test_model_access_check.py
@@ -0,0 +1,354 @@
+from types import SimpleNamespace
+
+import pytest
+
+import agent.auxiliary_client as auxiliary
+from agent.model_access_check import check_model_access
+
+
+class ProviderError(Exception):
+    status_code = 403
+
+
+def _response(model=None, *, marker=..., content="OK", finish_reason="stop", provider_status=...):
+    response = SimpleNamespace(
+        model=model,
+        choices=[SimpleNamespace(
+            message=SimpleNamespace(content=content), finish_reason=finish_reason,
+        )],
+    )
+    if marker is not ...:
+        response._hermes_provider_model = marker
+    if provider_status is not ...:
+        response._hermes_provider_status = provider_status
+    return response
+
+
+def _patch_resolution(monkeypatch, client, *, model="candidate", response=None, error=None):
+    calls = []
+    monkeypatch.setattr(
+        auxiliary,
+        "resolve_provider_client",
+        lambda *args, **kwargs: (calls.append((args, kwargs)) or (client, model)),
+    )
+    monkeypatch.setattr(
+        auxiliary,
+        "_effective_provider_for_client",
+        lambda _client, fallback: fallback,
+    )
+    monkeypatch.setattr(auxiliary, "_normalize_aux_provider", lambda value: value.lower())
+    monkeypatch.setattr(
+        auxiliary,
+        "_build_call_kwargs",
+        lambda provider, model, messages, **kwargs: {
+            "provider": provider,
+            "model": model,
+            "messages": messages,
+            **kwargs,
+        },
+    )
+    monkeypatch.setattr(auxiliary, "_provider_requires_stream", lambda *_args: False)
+    if error is not None:
+        def reject(*_args, **_kwargs):
+            raise error
+        monkeypatch.setattr(auxiliary, "_create_with_progress", reject)
+    else:
