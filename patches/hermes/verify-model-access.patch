+def test_profile_checks_use_the_requested_profile_scope(monkeypatch, tmp_path):
+    import tui_gateway.server as server
+    from agent import secret_scope
+    from hermes_constants import get_hermes_home
+
+    homes = {name: tmp_path / name for name in ("alpha", "beta")}
+    for name, home in homes.items():
+        home.mkdir()
+        (home / ".env").write_text(f"OPENROUTER_API_KEY=sk-{name}-profile-secret-0000\n")
+    monkeypatch.setattr("hermes_cli.profiles.profile_exists", homes.__contains__)
+    monkeypatch.setattr(server, "_profile_home", lambda name: homes.get(name))
+    seen = []
+
+    def fake_check(provider, model):
+        seen.append((provider, model, str(get_hermes_home()), secret_scope.get_secret("OPENROUTER_API_KEY")))
+        return {
+            "ok": True,
+            "status": "smoke_verified",
+            "provider": provider,
+            "model": model,
+            "resolved_provider": provider,
+            "resolved_model": model,
+            "response_model": model,
+        }
+
+    monkeypatch.setattr("agent.model_access_check.check_model_access", fake_check)
+    secret_scope.set_multiplex_active(True)
+    try:
+        first = server.handle_request({
+            "id": "1",
+            "method": "model.check",
+            "params": {"profile": "alpha", "provider": "openrouter", "model": "candidate"},
+        })
+        second = server.handle_request({
+            "id": "2",
+            "method": "model.check",
+            "params": {"profile": "beta", "provider": "openrouter", "model": "candidate"},
+        })
+    finally:
+        secret_scope.set_multiplex_active(False)
+
+    assert first["result"]["status"] == "smoke_verified"
+    assert second["result"]["status"] == "smoke_verified"
+    assert seen == [
+        ("openrouter", "candidate", str(homes["alpha"]), "sk-alpha-profile-secret-0000"),
+        ("openrouter", "candidate", str(homes["beta"]), "sk-beta-profile-secret-0000"),
+    ]
+
