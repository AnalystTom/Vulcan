+@method("model.check")
+def _(rid, params: dict) -> dict:
+    """Smoke one exact profile/provider/model without config or session mutation.
+
+    Unlike model.options and setup.runtime_check, this reports request-level serving. The
+    check helper resolves one concrete client directly, so no configured fallback can turn a
+    different provider/model into a false positive.
+    """
+    provider_value = params.get("provider")
+    model_value = params.get("model")
+    provider = provider_value.strip() if isinstance(provider_value, str) else ""
+    model = model_value.strip() if isinstance(model_value, str) else ""
+    if not provider or not model:
+        return _ok(rid, {
+            "ok": False,
+            "status": "unqualified",
+            "reason": "invalid_request",
+            "provider": provider,
+            "model": model,
+        })
+
+    try:
+        from agent.model_access_check import check_model_access
+
+        def probe(_profile, scoped):
+            return {**check_model_access(provider, model), **scoped}
+
+        return _readiness_check(rid, params, probe)
+    except Exception as error:
+        from agent.redact import redact_sensitive_text
+
+        return _ok(rid, {
+            "ok": False,
+            "status": "unqualified",
+            "reason": "check_failed",
+            "provider": provider,
+            "model": model,
+            "error": redact_sensitive_text(
+                str(error) or type(error).__name__, force=True, redact_url_credentials=True
+            )[:512],
+            **({"profile": params.get("profile")} if params.get("profile") else {}),
+        })
+
