diff --git a/agent/model_access_check.py b/agent/model_access_check.py
new file mode 100644
index 0000000000..5d7164ca71
--- /dev/null
+++ b/agent/model_access_check.py
@@ -0,0 +1,198 @@
+"""Exact model access checks for profile-scoped setup surfaces.
+
+This is deliberately separate from the auxiliary call policy: checking one candidate must never
+silently switch to another provider/model or write a session/config row.
+"""
+
+from typing import Any, Optional
+
+
+def _safe_error(error: BaseException) -> str:
+    from agent.redact import redact_sensitive_text
+
+    return redact_sensitive_text(
+        str(error) or type(error).__name__, force=True, redact_url_credentials=True
+    )[:512]
+
+
+def _result(
+    *,
+    provider: str,
+    model: str,
+    status: str,
+    reason: Optional[str] = None,
+    resolved_provider: Optional[str] = None,
+    resolved_model: Optional[str] = None,
+    response_model: Optional[str] = None,
+    error: Optional[BaseException] = None,
+) -> dict[str, Any]:
+    payload: dict[str, Any] = {
+        "ok": status == "smoke_verified",
+        "status": status,
+        "provider": provider,
+        "model": model,
+        "resolved_provider": resolved_provider,
+        "resolved_model": resolved_model,
+        "response_model": response_model,
+    }
+    if reason:
+        payload["reason"] = reason
+    if error is not None:
+        payload["error"] = _safe_error(error)
+        status_code = getattr(error, "status_code", None)
+        if isinstance(status_code, int):
+            payload["status_code"] = status_code
+    return payload
+
+
+def check_model_access(
+    provider: Any,
+    model: Any,
+    *,
+    timeout: float = 15.0,
+) -> dict[str, Any]:
+    """Make one exact, stateless request and report only provider-backed provenance.
+
+    This deliberately bypasses ``call_llm``: its recovery ladder can choose another
+    provider/model. Adapter responses carry ``_hermes_provider_model`` when their
+    public ``model`` field is synthesized; a missing marker is treated as raw
+    OpenAI-compatible provider evidence.
+    """
+    provider = provider.strip() if isinstance(provider, str) else ""
+    model = model.strip() if isinstance(model, str) else ""
+    if not provider or not model:
+        return _result(provider=provider, model=model, status="unqualified", reason="invalid_request")
+
+    from agent.auxiliary_client import (
+        _MISSING_PROVIDER_MODEL,
+        _build_call_kwargs,
+        _create_with_progress,
+        _effective_provider_for_client,
+        _normalize_aux_provider,
+        _provider_requires_stream,
+        resolve_provider_client,
+    )
+
+    normalized_provider = _normalize_aux_provider(provider)
+    if normalized_provider in {"auto", "moa"}:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="provider_must_be_explicit",
+        )
+
+    try:
+        client, resolved_model = resolve_provider_client(
+            provider, model=model, async_mode=False, task=None,
+        )
+    except Exception as error:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="resolution_failed", error=error,
+        )
+
+    resolved_provider = _effective_provider_for_client(client, provider) if client is not None else None
+    if client is None:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="credentials_unavailable", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+
+    resolved_model = resolved_model.strip() if isinstance(resolved_model, str) else None
+    if resolved_model != model:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="model_resolution_mismatch", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+    if _normalize_aux_provider(str(resolved_provider or "")) != normalized_provider:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="provider_resolution_mismatch", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+
+    client_base_url = str(getattr(client, "base_url", "") or "")
+    kwargs = _build_call_kwargs(
+        str(resolved_provider or provider), model,
+        [{"role": "user", "content": "Reply with the single word OK."}],
+        temperature=0, max_tokens=32, timeout=timeout, base_url=client_base_url, task=None,
+    )
+    try:
+        response = _create_with_progress(
+            client, kwargs, "model_check",
+            force_stream=_provider_requires_stream(str(resolved_provider or provider), client_base_url),
+        )
+    except Exception as error:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="request_rejected", resolved_provider=resolved_provider,
+            resolved_model=resolved_model, error=error,
+        )
+
+    choices = getattr(response, "choices", None)
+    if not isinstance(choices, (list, tuple)) or not choices:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="invalid_response", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+    choice = choices[0]
+    message = getattr(choice, "message", None)
+    if message is None:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="invalid_response", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+    provider_status = getattr(response, "_hermes_provider_status", _MISSING_PROVIDER_MODEL)
+    if provider_status is not _MISSING_PROVIDER_MODEL:
+        provider_status = provider_status.strip().lower() if isinstance(provider_status, str) else ""
+        if provider_status != "completed":
+            return _result(
+                provider=provider, model=model, status="unqualified",
+                reason="incomplete_response", resolved_provider=resolved_provider,
+                resolved_model=resolved_model,
+            )
+    finish_reason = str(getattr(choice, "finish_reason", "") or "").strip().lower()
+    if finish_reason in {"length", "max_tokens"}:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="truncated_response", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+    if provider_status is _MISSING_PROVIDER_MODEL and finish_reason not in {"stop", "end_turn"}:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="nonterminal_response", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+    content = getattr(message, "content", None)
+    if not isinstance(content, str) or not content.strip():
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="empty_response", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+
+    marker = getattr(response, "_hermes_provider_model", _MISSING_PROVIDER_MODEL)
+    response_model = marker if marker is not _MISSING_PROVIDER_MODEL else getattr(response, "model", None)
+    response_model = response_model.strip() if isinstance(response_model, str) else None
+    if not response_model:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="response_model_missing", resolved_provider=resolved_provider,
+            resolved_model=resolved_model,
+        )
+    if response_model != model:
+        return _result(
+            provider=provider, model=model, status="unqualified",
+            reason="response_model_mismatch", resolved_provider=resolved_provider,
+            resolved_model=resolved_model, response_model=response_model,
+        )
+    return _result(
+        provider=provider, model=model, status="smoke_verified",
+        resolved_provider=resolved_provider, resolved_model=resolved_model,
+        response_model=response_model,
+    )
+
