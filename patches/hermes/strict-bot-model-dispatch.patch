+def _profile_is_bot_managed(home: Path) -> bool:
+    """Return the strict Bot roster marker; malformed marked metadata fails closed."""
+    profile = Path(home) / "profile.yaml"
+    if not profile.is_file():
+        return False
+    try:
+        raw = profile.read_text(encoding="utf-8")
+    except Exception as error:
+        raise RuntimeError(f"Bot profile metadata unreadable: {error}") from error
+    if "hermes-bots" not in raw:
+        return False
+    try:
+        import yaml
+        data = yaml.safe_load(raw)
+    except Exception as error:
+        raise RuntimeError("Bot profile metadata is malformed") from error
+    if not isinstance(data, dict):
+        raise RuntimeError("Bot profile metadata is malformed")
+    ui_meta = data.get("ui_meta")
+    bots = ui_meta.get("hermes-bots") if isinstance(ui_meta, dict) else None
+    if not isinstance(bots, dict):
+        raise RuntimeError("Bot profile metadata is malformed")
+    return True
+
+
+def _profile_model_target() -> tuple[str, str]:
+    """Read the profile's explicit model/provider pin under its active home scope."""
+    from hermes_cli.config import load_config_readonly
+
+    config = load_config_readonly() or {}
+    raw = config.get("model") if isinstance(config, dict) else None
+    if isinstance(raw, dict):
+        model = raw.get("default") or raw.get("model")
+        provider = raw.get("provider")
+        return (
+            model.strip() if isinstance(model, str) else "",
+            provider.strip() if isinstance(provider, str) else "",
+        )
+    return (raw.strip() if isinstance(raw, str) else ""), ""
+
+
+@contextlib.contextmanager
+def _profile_check_scope(home: Path):
+    """Install only the profile scopes needed by the exact model check."""
+    from agent.secret_scope import (
+        build_profile_secret_scope,
+        reset_secret_scope,
+        set_secret_scope,
+    )
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    home_token = set_hermes_home_override(home)
+    secret_token = None
+    try:
+        secret_token = set_secret_scope(build_profile_secret_scope(home))
+        yield
+    finally:
+        if secret_token is not None:
+            reset_secret_scope(secret_token)
+        reset_hermes_home_override(home_token)
+
+
+def qualify_profile_model(
+    home: str | Path,
+    *,
+    model: Any = None,
+    provider: Any = None,
+    explicit_base_url: Any = None,
+    explicit_api_key: Any = None,
+    api_mode: Any = None,
+    strict: bool = False,
+) -> dict[str, Any] | None:
+    """Qualify one profile's exact Bot model before any agent/tool work.
+
+    strict is used by explicit Bot execution boundaries (canonical Bot Chat, hosted
+    room members, and Bot handoff). Ordinary profiles retain their existing fallback
+    behavior unless the profile is explicitly Bot Mode managed.
+    """
+    profile_home = Path(home).expanduser()
+    try:
+        profile_is_managed = _profile_is_bot_managed(profile_home)
+    except Exception as error:
+        # Strict Bot execution cannot turn unreadable/malformed managed metadata into
+        # an ordinary profile, where the runtime fallback ladder would be allowed.
+        if strict:
+            return _result(provider="", model="", status="unqualified", reason="bot_metadata_invalid", error=error)
+        raise
+    if not strict and not profile_is_managed:
+        return None
+    for value in (model, provider, explicit_base_url, api_mode):
+        if value is not None and not isinstance(value, str):
+            return _result(provider="", model="", status="unqualified", reason="invalid_request")
+    if explicit_api_key is not None and not isinstance(explicit_api_key, str) and not callable(explicit_api_key):
+        return _result(provider="", model="", status="unqualified", reason="invalid_request")
+    with _profile_check_scope(profile_home):
+        target_model = model.strip() if isinstance(model, str) else ""
+        target_provider = provider.strip() if isinstance(provider, str) else ""
+        if (model is not None and not target_model) or (provider is not None and not target_provider):
+            return _result(
+                provider=target_provider,
+                model=target_model,
+                status="unqualified",
+                reason="profile_model_not_explicit",
+            )
+        profile_model, profile_provider = _profile_model_target()
+        target_model = target_model or profile_model
+        target_provider = target_provider or profile_provider
+        if not target_model or not target_provider:
+            return _result(
+                provider=target_provider,
+                model=target_model,
+                status="unqualified",
+                reason="profile_model_not_explicit",
+            )
+        overrides = {
+            "explicit_base_url": explicit_base_url,
+            "explicit_api_key": explicit_api_key,
+            "api_mode": api_mode,
+        }
+        if any(value is not None for value in overrides.values()):
+            return check_model_access(target_provider, target_model, **overrides)
+        return check_model_access(target_provider, target_model)
+
+
+def require_profile_model(
+    home: str | Path,
+    *,
+    model: Any = None,
+    provider: Any = None,
+    explicit_base_url: Any = None,
+    explicit_api_key: Any = None,
+    api_mode: Any = None,
+    strict: bool = False,
+) -> None:
+    """Raise before execution when the profile's exact model is not provider-verified."""
+    result = qualify_profile_model(
+        home,
+        model=model,
+        provider=provider,
+        explicit_base_url=explicit_base_url,
+        explicit_api_key=explicit_api_key,
+        api_mode=api_mode,
+        strict=strict,
+    )
+    if result is None or result.get("status") == "smoke_verified":
+        return
+    provider_label = str(result.get("provider") or "").strip() or "(unset)"
+    model_label = str(result.get("model") or "").strip() or "(unset)"
+    reason = str(result.get("reason") or "qualification_failed").strip()
+    raise RuntimeError(
+        f"Bot model qualification failed for provider '{provider_label}' and model '{model_label}' "
+        f"({reason}). Verify the profile's explicit provider/model and credentials, then retry."
+    )
