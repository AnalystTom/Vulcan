diff --git a/tests/cli/test_resume_model_restore.py b/tests/cli/test_resume_model_restore.py
index aa01462527..30a836df19 100644
--- a/tests/cli/test_resume_model_restore.py
+++ b/tests/cli/test_resume_model_restore.py
@@ -367 +367,19 @@ def test_restore_session_model_restores_billing_provider_fallback():
     assert stub.provider == "minimax"
+
+
+def test_strict_bot_resume_keeps_profile_model_for_followup_turns(monkeypatch):
+    monkeypatch.setenv("HERMES_STRICT_BOT_MODEL", "1")
+    calls = []
+
+    class Agent:
+        def switch_model(self, **kwargs):
+            calls.append(kwargs)
+
+    stub = _make_stub(model="gpt-6-astra", provider="openai-codex",
+                      requested_provider="openai-codex", agent=Agent())
+    stub._restore_session_model(_row(model="gpt-5.6-luna", model_config={
+        "gateway_runtime": {"provider": "openai-codex"},
+    }))
+    assert stub.model == "gpt-6-astra"
+    assert stub.provider == "openai-codex"
+    assert calls == []
