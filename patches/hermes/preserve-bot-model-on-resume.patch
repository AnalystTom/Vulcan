+def test_strict_bot_oneshot_resume_keeps_profile_route(monkeypatch):
+    monkeypatch.setenv("HERMES_STRICT_BOT_MODEL", "1")
+    choice = _ModelChoice("gpt-6-astra", "openai-codex")
+    result = _apply_stored_session_runtime(choice, {
+        "model": "gpt-5.6-luna", "model_config": '{"provider":"openai-codex"}',
+    }, explicit_model=False)
+    assert result is choice
+    assert result.model == "gpt-6-astra"
+    assert result.provider == "openai-codex"
