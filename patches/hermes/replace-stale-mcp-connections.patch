+def test_overlapping_same_profile_discovery_keeps_newest_route(two_profiles, monkeypatch):
+    import asyncio
+    import contextvars
+    import threading
+    from tools import mcp_tool as core, mcp_tool_discovery as disc, mcp_tool_registration as reg
+
+    scope = two_profiles("a")
+    old, new = {"url": "https://mcp.example/old"}, {"url": "https://mcp.example/new"}
+    entered, release, newer_entered, newer_done = (threading.Event() for _ in range(4))
+    errors = []
+    def discover(configs):
+        if configs["x"] == old:
+            entered.set()
+            assert release.wait(3)
+        server = _server("x", configs["x"])
+        async def shutdown():
+            for name in server._registered_tool_names:
+                reg._deregister_mcp_tool_all_scopes(server, name)
+            server.session = None
+        server.shutdown = shutdown
+        disc._adopt_server("x", server)
+        server._registered_tool_names = reg._register_server_tools("x", server, configs["x"])
+    monkeypatch.setattr(disc._loop, "_ensure_mcp_loop", lambda: None)
+    monkeypatch.setattr(disc._loop, "_run_on_mcp_loop", lambda fn, **kw: asyncio.run(fn()))
+    monkeypatch.setattr(disc, "_run_discovery_pass", discover)
+    def run(config):
+        try:
+            if config == new:
+                newer_entered.set()
+            disc.register_mcp_servers({"x": config})
+        except BaseException as error:
+            errors.append(error)
+        finally:
+            if config == new:
+                newer_done.set()
+    threads = [threading.Thread(target=contextvars.copy_context().run, args=(run, config))
+               for config in (old, new)]
+    try:
+        threads[0].start()
+        assert entered.wait(3)
+        threads[1].start()
+        assert newer_entered.wait(3)
+        assert not newer_done.wait(0.1)
+    finally:
+        release.set()
+        for thread in threads:
+            if thread.ident is not None:
+                thread.join(3)
+    assert not any(thread.is_alive() for thread in threads)
+    assert errors == []
+    assert core._servers[(scope, "x")]._config == new
+    assert disc.get_mcp_status({"x": new})[0]["connected"]
+
