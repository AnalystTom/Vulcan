+def _retire_mcp_server(key, server, *, scope: Optional[str]) -> bool:
+    """Retire one owned connection after its profile's route changed.
+
+    This is the single-server counterpart to :func:`shutdown_mcp_servers`: it keeps other
+    connections owned by the profile alive and records adopters for the normal post-discovery
+    re-registration pass.
+    """
+    with _core._lock:
+        if (_core._servers.get(key) is not server
+                or _core._server_scope_keys.get(key) != scope):
+            return False
+        adopters = set(_core._server_tool_scopes.get(key, ())) - {scope}
+
+    try:
+        # MCPServerTask.shutdown() must run on the loop that owns its async transport context.
+        _loop._ensure_mcp_loop()
+        _loop._run_on_mcp_loop(server.shutdown, timeout=15)
+    except Exception as exc:
+        logger.debug("MCP: retiring stale server '%s' failed: %s", _key_name(key), exc)
+        # Keep the key occupied until teardown is confirmed. A timed-out shutdown may
+        # still deregister tools; admitting a replacement now would let it erase those tools.
+        return False
+    with _core._lock:
+        if _core._servers.get(key) is not server:
+            return False
+        _core._servers.pop(key, None)
+        _core._server_scope_keys.pop(key, None)
+        _core._server_tool_scopes.pop(key, None)
+        _core._server_connecting.discard(key)
+        _core._server_connect_errors.pop(key, None)
+        _core._server_error_counts.pop(key, None)
+        _core._server_breaker_opened_at.pop(key, None)
+        _clear_connect_cooldowns({key})
+        for adopter in adopters:
+            _core._orphaned_adopters.setdefault(adopter, set()).add(_key_name(key))
+    return True
 
 
