+def test_browser_without_vault_profile_pin_is_saved_and_reaches_native_resolver(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    from hermes_cli.tools_config import _get_platform_tools
+    from tui_gateway import server
+
+    result = server._methods["profiles.configure"](
+        1, {"name": "default", "enabled_toolsets": ["browser_without_vault"]}
+    )
+    assert result["result"]["applied"]["toolsets"] is True
+
+    saved = yaml.safe_load((home / "config.yaml").read_text(encoding="utf-8"))
+    assert saved["tools"]["enabled_toolsets"] == ["browser_without_vault"]
+    enabled = _get_platform_tools(saved, "cli", include_default_mcp_servers=False)
+    assert "browser_without_vault" in enabled
+    assert "browser" not in enabled
+
