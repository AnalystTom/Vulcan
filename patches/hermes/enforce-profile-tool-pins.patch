+def test_browser_without_vault_scopes_schema_dispatch_and_tool_search():
+    """The migration surface keeps browser research/control but cannot reach vault tools."""
+    import model_tools
+    import toolsets
+    from hermes_cli.tools_config import _get_effective_configurable_toolsets, _get_platform_tools
+    from tools.registry import registry
+    from tui_gateway.methods_profiles import _describe_toolsets
+
+    catalog_names = {name for name, _, _ in _get_effective_configurable_toolsets()}
+    assert "browser_without_vault" in catalog_names
+    described, pinned = _describe_toolsets(
+        {"tools": {"enabled_toolsets": ["browser_without_vault"]}}
+    )
+    assert pinned == {"browser_without_vault"}
+    assert any(row["name"] == "browser_without_vault" and row["enabled"] for row in described)
+    described_off, pinned_off = _describe_toolsets(
+        {"tools": {"enabled_toolsets": []}}
+    )
+    assert pinned_off == set()
+    assert any(row["name"] == "browser_without_vault" and not row["enabled"] for row in described_off)
+
+    native = _get_platform_tools(
+        {"platform_toolsets": {"cli": ["browser_without_vault"]}},
+        "cli",
+        include_default_mcp_servers=False,
+    )
+    assert "browser_without_vault" in native
+    default_native = _get_platform_tools(
+        {"platform_toolsets": {"cli": ["hermes-cli"]}},
+        "cli",
+        include_default_mcp_servers=False,
+    )
+    assert "browser" in default_native
+    assert "browser_without_vault" not in default_native
+    profile_native = _get_platform_tools(
+        {"tools": {"enabled_toolsets": ["browser_without_vault"]},
+         "platform_toolsets": {"cli": ["hermes-cli"]}},
+        "cli",
+        include_default_mcp_servers=False,
+    )
+    assert "browser_without_vault" in profile_native
+    assert "browser" not in profile_native
+    strict_profile = {
+        "tools": {"enabled_toolsets": ["browser_without_vault", "explicit_mcp"]},
+        "platform_toolsets": {"cli": ["hermes-cli"]},
+        "mcp_servers": {
+            "explicit_mcp": {"enabled": True},
+            "default_mcp": {"enabled": True},
+        },
+        "context": {"engine": "alternate"},
+    }
+    with patch("hermes_cli.tools_config._get_plugin_toolset_keys", return_value={"unmanaged_plugin"}):
+        strict_native = _get_platform_tools(strict_profile, "cli", include_default_mcp_servers=True)
+    assert {"browser_without_vault", "explicit_mcp"} <= strict_native
+    assert not {"browser", "default_mcp", "unmanaged_plugin", "context_engine"} & strict_native
+
+    toolset_tools = set(toolsets.resolve_toolset("browser_without_vault"))
+    assert {"browser_navigate", "browser_snapshot", "browser_click"} <= toolset_tools
+    assert not any(name.startswith("browser_vault_") for name in toolset_tools)
+
+    # Browser backends are intentionally unavailable in this hermetic test
+    # environment; make the registry availability pass observable here so the
+    # assertion exercises selected schemas rather than installation state.
+    with patch("tools.registry._memo_check", return_value=True):
+        definitions = model_tools.get_tool_definitions(
+            enabled_toolsets=["browser_without_vault"], quiet_mode=True,
+            skip_tool_search_assembly=True,
+        )
+    schema_names = {definition["function"]["name"] for definition in definitions}
+    assert {"browser_navigate", "browser_snapshot", "browser_click"} <= schema_names
+    assert not any(name.startswith("browser_vault_") for name in schema_names)
+    assert model_tools._tool_defs_cache_key(
+        ["browser"], None, True
+    ) != model_tools._tool_defs_cache_key(["browser_without_vault"], None, True)
+
+    with patch.object(registry, "dispatch", wraps=registry.dispatch) as dispatch:
+        direct = json.loads(model_tools.handle_function_call(
+            "browser_vault_list", {}, enabled_toolsets=["browser_without_vault"],
+        ))
+    assert "not available in this session" in direct["error"]
+    dispatch.assert_not_called()
+
+    stemmer = SimpleNamespace(stemWord=lambda word: word)
+    with patch.dict(sys.modules, {"snowballstemmer": SimpleNamespace(stemmer=lambda _: stemmer)}):
+        searched = json.loads(model_tools.handle_function_call(
+            "tool_search", {"queries": ["browser vault login"], "limit": 10},
+            enabled_toolsets=["browser_without_vault"],
+        ))
+    assert not any(name.startswith("browser_vault_") for name in searched["tools"])
+    blocked = json.loads(model_tools.handle_function_call(
+        "tool_call", {"name": "browser_vault_list", "arguments": {}},
+        enabled_toolsets=["browser_without_vault"],
+    ))
+    assert "not a deferrable tool" in blocked["error"]
+
