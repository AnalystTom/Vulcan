+def test_display_only_seed_stays_visible_but_is_excluded_from_model_resume(monkeypatch, tmp_path):
+    """Migration/import seeds remain in the GUI display projection without becoming model context."""
+    db = SessionDB(db_path=tmp_path / "state.db")
+    _quiet_create(monkeypatch, db)
+    sid = None
+    try:
+        result = _create({
+            "cols": 96, "source": "desktop", "title": "Imported Bot Chat", "seed_mode": "display_only",
+            "messages": [
+                {"role": "user", "content": "Historical task — do not resume"},
+                {"role": "assistant", "content": "Historical result"},
+            ],
+        })
+        sid, key = result["session_id"], result["stored_session_id"]
+        assert [message["text"] for message in result["messages"]] == [
+            "Historical task — do not resume", "Historical result"
+        ]
+        assert server._sessions[sid]["history"] == []
+        assert server._sessions[sid]["display_history_prefix"] == [
+            {"role": "user", "content": "Historical task — do not resume"},
+            {"role": "assistant", "content": "Historical result"},
+        ]
+
+        rows = db.get_messages(key, include_compacted=True)
+        assert [row["content"] for row in rows] == [
+            "Historical task — do not resume", "Historical result"
+        ]
+        assert all(row["active"] == 0 and row["compacted"] == 1 for row in rows)
+        assert db.get_session(key)["message_count"] == 0
+        model_history, display_history = db.get_resume_conversations(key)
+        assert model_history == []
+        assert [row["content"] for row in display_history] == [
+            "Historical task — do not resume", "Historical result"
+        ]
+
+        live = server.handle_request({
+            "id": "live", "method": "session.resume", "params": {"session_id": key, "cols": 96}
+        })["result"]
+        assert [message["text"] for message in live["messages"]] == [
+            "Historical task — do not resume", "Historical result"
+        ]
+        server._sessions.pop(sid)
+        resumed = server.handle_request({
+            "id": "cold", "method": "session.resume", "params": {"session_id": key, "cols": 96}
+        })["result"]
+        assert [message["text"] for message in resumed["messages"]] == [
+            "Historical task — do not resume", "Historical result"
+        ]
+        server._sessions.pop(resumed["session_id"], None)
+    finally:
+        if sid:
+            server._sessions.pop(sid, None)
+        db.close()
+
+
+def test_unknown_seed_mode_is_rejected(monkeypatch, tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    _quiet_create(monkeypatch, db)
+    try:
+        response = server.handle_request({
+            "id": "create", "method": "session.create",
+            "params": {"source": "desktop", "seed_mode": "model_only", "messages": [
+                {"role": "user", "content": "hello"},
+            ]},
+        })
+        assert response["error"]["code"] == 4002
+        assert "unsupported seed_mode" in response["error"]["message"]
+    finally:
+        db.close()
